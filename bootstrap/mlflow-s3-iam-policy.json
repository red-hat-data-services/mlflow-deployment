{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MLflowListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::ambient-code-mlflow-artifacts",
      "Condition": {
        "StringLike": { "s3:prefix": ["mlflow/*"] }
      }
    },
    {
      "Sid": "MLflowObjectReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::ambient-code-mlflow-artifacts/mlflow/*"
    }
  ]
}
